{
  "name": "accelerate-presenter",
  "version": "0.1.0",
  "private": true,
  "description": "Run a workshop from your phone. GitHub, slides and a real terminal on the projector, switched by swiping.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.accelerate.presenter",
    "productName": "Accelerate Presenter",
    "files": ["electron/**", "stage/**", "phone/**", "package.json"],
    "win": { "target": "nsis" }
  }
}
