% ---------------------------------------------------------------------------
%  rabbithole.sty
%  Shared design for the "Rabbit Holes" handbook.
%  Accelerate, Manipal University Jaipur. MIT licensed.
%
%  Build with xelatex (needs fontspec). Fonts degrade gracefully: it tries a
%  Windows set, then a common Linux/macOS set, then whatever TeX has.
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rabbithole}[2026/08/24 Rabbit Holes handbook style]

\RequirePackage{fontspec}
\RequirePackage[a4paper,top=25mm,bottom=25mm,left=28mm,right=28mm,headsep=8mm,footskip=14mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{microtype}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{bookmark}

% ------------------------------- palette -----------------------------------
\definecolor{rhink}{HTML}{16181D}
\definecolor{rhslate}{HTML}{2F3A4A}
\definecolor{rhaccent}{HTML}{E8542A}   % git orange
\definecolor{rhmuted}{HTML}{6B7280}
\definecolor{rhcodebg}{HTML}{F6F7F9}
\definecolor{rhborder}{HTML}{E3E6EA}
\definecolor{rhblue}{HTML}{2563EB}
\definecolor{rhred}{HTML}{DC2626}
\definecolor{rhgreen}{HTML}{059669}
\definecolor{rhpurple}{HTML}{7C3AED}
\definecolor{rhkw}{HTML}{1D4ED8}
\definecolor{rhstr}{HTML}{047857}
\definecolor{rhcomment}{HTML}{8A93A0}

% -------------------------------- fonts ------------------------------------
\IfFontExistsTF{Georgia}{\setmainfont{Georgia}}{%
  \IfFontExistsTF{Charter}{\setmainfont{Charter}}{%
    \IfFontExistsTF{DejaVu Serif}{\setmainfont{DejaVu Serif}}{}}}
\IfFontExistsTF{Segoe UI}{\setsansfont{Segoe UI}}{%
  \IfFontExistsTF{Helvetica Neue}{\setsansfont{Helvetica Neue}}{%
    \IfFontExistsTF{DejaVu Sans}{\setsansfont{DejaVu Sans}}{}}}
\IfFontExistsTF{Consolas}{\setmonofont[Scale=0.88]{Consolas}}{%
  \IfFontExistsTF{Menlo}{\setmonofont[Scale=0.88]{Menlo}}{%
    \IfFontExistsTF{DejaVu Sans Mono}{\setmonofont[Scale=0.85]{DejaVu Sans Mono}}{}}}

\color{rhink}
\linespread{1.16}
\setlength{\parskip}{0.62em}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{3em}

% ------------------------------ phase metadata -----------------------------
\newcommand{\phasenumber}[1]{\gdef\rh@num{#1}}
\newcommand{\phasetitle}[1]{\gdef\rh@title{#1}}
\newcommand{\phasesubtitle}[1]{\gdef\rh@sub{#1}}
\gdef\rh@num{0}\gdef\rh@title{Untitled}\gdef\rh@sub{}

% -------------------------------- headings ---------------------------------
\titleformat{\section}
  {\sffamily\bfseries\Large\color{rhslate}}
  {\color{rhaccent}\thesection}{0.6em}{}
  [{\vspace{2pt}\color{rhborder}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{1.8em plus 0.4em minus 0.2em}{0.7em}

\titleformat{\subsection}
  {\sffamily\bfseries\large\color{rhslate}}
  {\color{rhaccent}\thesubsection}{0.55em}{}
\titlespacing*{\subsection}{0pt}{1.3em plus 0.3em minus 0.2em}{0.4em}

\titleformat{\subsubsection}
  {\sffamily\bfseries\normalsize\color{rhslate}}
  {}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{1.0em plus 0.2em}{0.3em}

% -------------------------------- headers ----------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\sffamily\footnotesize\color{rhmuted}Rabbit Holes}
\fancyhead[R]{\sffamily\footnotesize\color{rhmuted}Phase \rh@num\ \textperiodcentered\ \rh@title}
\fancyfoot[C]{\sffamily\footnotesize\color{rhmuted}\thepage}

\fancypagestyle{rhplain}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\sffamily\footnotesize\color{rhmuted}\thepage}}

% ------------------------------- code blocks -------------------------------
\lstdefinelanguage{rhshell}{
  morekeywords={git,gh,cd,ls,cat,echo,export,cp,mv,rm,mkdir,grep,sed,awk,curl,
    printf,python,pip,npm,make,sudo,ssh,diff,less,head,tail,find,xargs,tr,sort,uniq,wc},
  morekeywords=[2]{add,commit,push,pull,fetch,merge,rebase,switch,checkout,branch,
    status,log,diff,reset,restore,revert,stash,clean,cherry,tag,remote,clone,init,
    config,show,blame,bisect,reflog,worktree,submodule,sparse,gc,fsck,apply,am,
    format,send,notes,describe,archive,shortlog,grep,mergetool,rerere,maintenance,
    repack,prune,verify,cat,hash,rev,update,symbolic,ls,for,pr,repo,issue,api,
    auth,release,workflow,run,alias,extension,secret,label,gist,browse,search,
    codespace,ruleset,variable,cache,project,org},
  morecomment=[l]{\#},
  morestring=[b]",
  morestring=[b]',
  sensitive=true,
}
\lstdefinestyle{rhcode}{
  language=rhshell,
  basicstyle=\ttfamily\footnotesize\color{rhink},
  keywordstyle=\color{rhkw}\bfseries,
  keywordstyle=[2]\color{rhaccent},
  commentstyle=\color{rhcomment}\itshape,
  stringstyle=\color{rhstr},
  backgroundcolor=\color{rhcodebg},
  frame=leftline,
  framerule=2pt,
  rulecolor=\color{rhaccent},
  framesep=7pt,
  xleftmargin=9pt,
  xrightmargin=0pt,
  aboveskip=1.0em,
  belowskip=1.0em,
  breaklines=true,
  breakatwhitespace=false,
  postbreak=\mbox{\textcolor{rhmuted}{$\hookrightarrow$}\space},
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  literate={~}{{\textasciitilde}}1 {<}{{\textless}}1 {>}{{\textgreater}}1
           {`}{{\textasciigrave}}1 {'}{{\textquotesingle}}1,
}
\lstset{style=rhcode}

% Plain block for output/diffs, no keyword colouring
\lstdefinestyle{rhout}{
  language={},
  basicstyle=\ttfamily\footnotesize\color{rhslate},
  backgroundcolor=\color{rhcodebg},
  frame=leftline, framerule=2pt, rulecolor=\color{rhborder},
  framesep=7pt, xleftmargin=9pt,
  aboveskip=1.0em, belowskip=1.0em,
  breaklines=true, showstringspaces=false,
  columns=fullflexible, keepspaces=true, upquote=true,
  literate={~}{{\textasciitilde}}1 {<}{{\textless}}1 {>}{{\textgreater}}1,
}
\lstnewenvironment{shell}{\lstset{style=rhcode}}{}
\lstnewenvironment{terminal}{\lstset{style=rhout}}{}

% inline code
\newcommand{\co}[1]{{\ttfamily\small\color{rhslate}#1}}

% ------------------------------- callouts ----------------------------------
\newtcolorbox{rhbox}[2]{
  enhanced, breakable,
  colback=#1!3, colframe=#1,
  boxrule=0pt, leftrule=2.5pt,
  arc=0pt, outer arc=0pt,
  left=9pt, right=9pt, top=7pt, bottom=7pt,
  boxsep=0pt,
  before skip=1.1em, after skip=1.1em,
  fonttitle=\sffamily\bfseries\footnotesize,
  coltitle=#1,
  title={\MakeUppercase{#2}},
  attach title to upper={\par\vspace{4pt}},
}
\newenvironment{why}{\begin{rhbox}{rhblue}{Why this exists}}{\end{rhbox}}
\newenvironment{trap}{\begin{rhbox}{rhred}{Trap}}{\end{rhbox}}
\newenvironment{tryit}{\begin{rhbox}{rhgreen}{Try it}}{\end{rhbox}}
\newenvironment{deeper}{\begin{rhbox}{rhpurple}{Deeper}}{\end{rhbox}}
\newenvironment{note}{\begin{rhbox}{rhmuted}{Note}}{\end{rhbox}}

% ------------------------------ list spacing -------------------------------
\setlist[itemize]{leftmargin=1.2em,itemsep=0.25em,topsep=0.35em,parsep=0pt}
\setlist[enumerate]{leftmargin=1.4em,itemsep=0.25em,topsep=0.35em,parsep=0pt}
\setlist[description]{leftmargin=0pt,itemsep=0.4em,topsep=0.4em,
  font=\sffamily\bfseries\color{rhslate}}

% -------------------------------- tables -----------------------------------
\renewcommand{\arraystretch}{1.28}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcommand{\rhtablehead}[1]{\sffamily\bfseries\small\color{rhslate}#1}

% ------------------------------ toc entries --------------------------------
\titlecontents{section}[0em]
  {\vspace{0.5em}\sffamily\small\color{rhslate}}
  {\color{rhaccent}\makebox[1.7em][l]{\thecontentslabel}}
  {\hspace*{1.7em}}
  {\hfill\color{rhmuted}\thecontentspage}

\titlecontents{subsection}[1.7em]
  {\vspace{0.12em}\rmfamily\small\color{rhmuted}}
  {\makebox[2.3em][l]{\thecontentslabel}}
  {\hspace*{2.3em}}
  {\hfill\color{rhmuted}\thecontentspage}

% ------------------------------ title block --------------------------------
\newcommand{\maketitlepage}{%
  \thispagestyle{empty}
  \vspace*{2.2cm}
  {\sffamily\footnotesize\color{rhaccent}\bfseries\MakeUppercase{Rabbit Holes}\par}
  {\sffamily\footnotesize\color{rhmuted}Accelerate \textperiodcentered\ Manipal University Jaipur\par}
  \vspace{1.6cm}
  {\sffamily\fontsize{58}{58}\selectfont\color{rhborder}\bfseries \rh@num\par}
  \vspace{-0.15cm}
  {\sffamily\footnotesize\color{rhmuted}\MakeUppercase{Phase}\par}
  \vspace{0.7cm}
  {\sffamily\fontsize{27}{31}\selectfont\bfseries\color{rhslate} \rh@title\par}
  \vspace{0.5cm}
  {\rmfamily\large\color{rhmuted} \rh@sub\par}
  \vspace{1.2cm}
  {\color{rhaccent}\rule{3.5cm}{2.5pt}\par}
  \vfill
  {\sffamily\scriptsize\color{rhmuted}
   Part of \textbf{git started}, Accelerate's third workshop.\\
   github.com/accelerate-muj/git-started \textperiodcentered\ MIT licensed.\par}
  \newpage
  \pagestyle{rhplain}
  {\sffamily\bfseries\Large\color{rhslate}Contents\par}
  \vspace{0.3em}{\color{rhborder}\rule{\linewidth}{0.8pt}\par}
  \vspace{0.6em}
  \begingroup
  \hypersetup{linkcolor=rhink}
  \setcounter{tocdepth}{2}
  \makeatletter\@starttoc{toc}\makeatother
  \endgroup
  \newpage
  \pagestyle{fancy}
}

% closing "what you can now answer" block
\newcommand{\checkyourself}[1]{%
  \needspace{4\baselineskip}
  \begin{rhbox}{rhslate}{Check yourself}#1\end{rhbox}}

\hypersetup{
  colorlinks=true, linkcolor=rhslate, urlcolor=rhaccent, citecolor=rhaccent,
  pdfstartview={FitH}, bookmarksnumbered=true, bookmarksopen=true,
}

\endinput
